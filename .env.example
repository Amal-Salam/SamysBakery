# Copy to .env.local and fill in real values. Never commit .env.local.
# Variables prefixed NEXT_PUBLIC_ are exposed to the browser — never put secrets in them.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never import into client code.
SUPABASE_SERVICE_ROLE_KEY=

# Paystack
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
# Server-only.
PAYSTACK_SECRET_KEY=

# Resend (server-only)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Google OAuth (configured in Supabase Auth; kept here for reference)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
