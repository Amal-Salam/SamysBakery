# Public build-time settings for the app. Only PUBLIC values belong here:
# anything in an app bundle can be extracted. Never put a secret key here.
#
# Local testing on a phone (same Wi-Fi as your Mac): use your Mac's LAN IP.
EXPO_PUBLIC_API_URL=http://192.168.x.x:3000
EXPO_PUBLIC_SUPABASE_URL=http://192.168.x.x:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
